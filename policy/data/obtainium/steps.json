{
  "package": "dev.imranr.obtainium",
  "artifact": "obtainium.json",
  "volatile": [
    "exportedAt",
    "apps.lastUpdateCheck",
    "apps.latestVersionChangedAt",
    "apps.latestVersion",
    "apps.installedVersion",
    "apps.releaseDate",
    "apps.releaseUrl",
    "apps.apkUrls",
    "apps.otherAssetUrls",
    "apps.apkSizeBytes",
    "apps.changeLog",
    "apps.consecutiveFailedChecks",
    "apps.newerReleasesFilteredOut",
    "apps.updateHealthDismissedVersion",
    "apps.updateHealthEnabled",
    "apps.isArchived",
    "apps.pendingRepoRenameUrl"
  ],
  "private": "private.json",
  "sort": [
    "apps"
  ],
  "backup": [
    {
      "key": {
        "code": "KEYCODE_HOME"
      }
    },
    {
      "launch": {
        "component": "dev.imranr.obtainium/.MainActivity",
        "clear": true
      }
    },
    {
      "wait": {
        "selector": {
          "desc": "Settings"
        }
      }
    },
    {
      "tap": {
        "selector": {
          "desc": "Settings"
        }
      }
    },
    {
      "wait": {
        "selector": {
          "desc": "Import/export",
          "class": "android.widget.Button"
        }
      }
    },
    {
      "tap": {
        "selector": {
          "desc": "Import/export",
          "class": "android.widget.Button"
        }
      }
    },
    {
      "wait": {
        "selector": {
          "desc": "Obtainium export",
          "class": "android.widget.Button"
        }
      }
    },
    {
      "tap": {
        "selector": {
          "desc": "Obtainium export",
          "class": "android.widget.Button"
        }
      }
    },
    {
      "sleep": {
        "seconds": 4
      }
    },
    {
      "pull": {
        "from": "/sdcard/phone-sync/configs/obtainium-export-*.json",
        "to": "{{artifact}}",
        "newest": true
      }
    }
  ],
  "restore": [
    {
      "key": {
        "code": "KEYCODE_HOME"
      }
    },
    {
      "push": {
        "from": "{{artifact}}",
        "to": "/sdcard/Download/{{artifact}}"
      }
    },
    {
      "launch": {
        "component": "dev.imranr.obtainium/.MainActivity",
        "clear": true
      }
    },
    {
      "wait": {
        "selector": {
          "desc": "Settings"
        },
        "timeout": 30
      }
    },
    {
      "tap": {
        "selector": {
          "desc": "Settings"
        }
      }
    },
    {
      "wait": {
        "selector": {
          "desc": "Import/export",
          "class": "android.widget.Button"
        }
      }
    },
    {
      "tap": {
        "selector": {
          "desc": "Import/export",
          "class": "android.widget.Button"
        }
      }
    },
    {
      "wait": {
        "selector": {
          "desc": "Obtainium import",
          "class": "android.widget.Button"
        }
      }
    },
    {
      "tap": {
        "selector": {
          "desc": "Obtainium import",
          "class": "android.widget.Button"
        }
      }
    },
    {
      "wait": {
        "selector": {
          "id": "com.google.android.documentsui:id/option_menu_search"
        }
      }
    },
    {
      "tap": {
        "selector": {
          "id": "com.google.android.documentsui:id/option_menu_search"
        }
      }
    },
    {
      "wait": {
        "selector": {
          "id": "com.google.android.documentsui:id/search_src_text"
        }
      }
    },
    {
      "type": {
        "selector": {
          "id": "com.google.android.documentsui:id/search_src_text"
        },
        "text": "{{artifact}}"
      }
    },
    {
      "key": {
        "code": "KEYCODE_ESCAPE"
      }
    },
    {
      "wait": {
        "selector": {
          "id": "android:id/title",
          "textContains": "{{artifact}}"
        }
      }
    },
    {
      "tap": {
        "selector": {
          "id": "android:id/title",
          "textContains": "{{artifact}}"
        }
      }
    },
    {
      "wait": {
        "selector": {
          "desc": "Continue"
        },
        "timeout": 20
      }
    },
    {
      "tap": {
        "selector": {
          "desc": "Continue"
        }
      }
    },
    {
      "sleep": {
        "seconds": 6
      }
    },
    {
      "sleep": {
        "seconds": 3
      }
    }
  ]
}
