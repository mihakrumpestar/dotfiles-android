# Generated by tooling; never committed.
.state/

# The private export tree is a repository of its own, checked out inside this one.
# It is ignored here in full: the public repository never sees its files.
/secrets/

# An export is a snapshot of one phone on one day, not policy: it names the apps
# someone runs, which is not something a public repository should carry. Exports
# live in the private android-secrets tree. Only a recipe and a JSON artifact can
# live beside it, and a recipe declares an artifact publishable only by naming the
# fields that `private` lifts out of it, which the tests check.
/policy/data/*/*
!/policy/data/*/steps.json
!/policy/data/*/*.json

# Go
/bin/

# devenv
.devenv/
